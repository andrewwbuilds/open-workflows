{
  "name": "open-workflows",
  "version": "0.2.0",
  "description": "A global OpenCode plugin for planner-worker-reviewer workflows and bounded agent loops",
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "commands",
    "agents",
    "scripts"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "install-assets": "node scripts/install-assets.js"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.14.48",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.1.0",
    "eslint": "^9.31.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22",
    "opencode": ">=1.14.0"
  },
  "license": "MIT"
}
